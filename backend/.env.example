# Database Configuration (SQLite default; set USE_SQLITE=false for SQL Server)
USE_SQLITE=true
DATABASE_URL=sqlite:///./stock_trading.db

# SQL Server Configuration (optional)
# USE_SQLITE=false
# DATABASE_URL=mssql+pyodbc://localhost/StockTrading?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Chatbot API (optional - for multilingual chatbot)
CHATBOT_API_KEY=your-gemini-or-openai-api-key
CHATBOT_MODEL=gemini-pro

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
